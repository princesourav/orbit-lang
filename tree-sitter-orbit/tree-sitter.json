{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "orbit",
      "camelcase": "Orbit",
      "scope": "source.orbit",
      "path": ".",
      "file-types": ["orbit"],
      "highlights": ["queries/highlights.scm"],
      "injections": ["queries/injections.scm"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for the Orbit template language (@orbitlang/core).",
    "authors": [
      {
        "name": "Orbit contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/princesourav/orbit-lang"
    }
  }
}
