{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    // Deliberately empty: the open engine must not depend on Node (or DOM) APIs —
    // no fs, no net, no clock. Keeping @types/node out makes an accidental
    // `process`/`Buffer`/`console` reference a compile error. lib excludes DOM too.
    "types": []
  },
  "include": ["src"]
}
