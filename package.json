{
  "name": "@orbitlang/core",
  "version": "0.1.0",
  "description": "Orbit — a typed, non-Turing-complete, HTML-strict template language for storefronts and content sites. Parser, typechecker, six-context autoescaping interpreter, fuel-metered deterministic rendering. Bring your own object model.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princesourav/orbit-lang.git"
  },
  "homepage": "https://github.com/princesourav/orbit-lang#readme",
  "bugs": "https://github.com/princesourav/orbit-lang/issues",
  "keywords": [
    "template-language",
    "templates",
    "typed",
    "autoescaping",
    "deterministic",
    "storefront",
    "orbit"
  ],
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/cli",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:cli && node scripts/fixup-dist.mjs",
    "build:cjs": "tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:claims": "node scripts/audit-claims.mjs",
    "sbom": "node scripts/sbom.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "playground": "node playground/build.mjs",
    "playground:check": "node playground/build.mjs --check",
    "llms": "node scripts/gen-llms-txt.mjs",
    "llms:check": "node scripts/gen-llms-txt.mjs --check",
    "eval": "vite-node llm/eval/run.mjs --",
    "conformance": "vite-node conformance/runner.mjs",
    "conformance:gen": "vite-node conformance/generate.mjs",
    "conformance:check": "vite-node conformance/generate.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "parse5": "^8.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "bin": {
    "orbit": "./dist/cli/cli.js"
  }
}
