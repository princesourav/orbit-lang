---
page index
settings {
  storiesHeading: Text = "Latest stories" label "Stories heading"
}
---
<main class="home" id="main">
  <PromoBanner/>
  <Panel tone="calm">
    <h2 slot="header">{shopName}</h2>
    <p class="home__intro">
      Everything below is rendered by the same engine that checked it: no truthiness, no dynamic member access, no unescaped sink except the one the host asked for.
    </p>
    <if {totalPages > 1}><p slot="footer">Showing page {pageNumber} of {totalPages}.</p></if>
  </Panel>
  <section class="home__stories">
    <h2>{settings.storiesHeading}</h2>
    <for story of={articles} limit={3}>
      <article class="teaser">
        <h3 class="teaser__title">
          <a href={story.url}>{story.title}</a>
        </h3>
        <p class="teaser__excerpt">{story.excerpt ?? "Read the full story."}</p>
        <time datetime={story.publishedAt}>{story.publishedAt |> formatDate("D MMM YYYY")}</time>
      </article>
    <empty>
      <p class="teaser teaser--empty">No stories published yet.</p>
    </empty>
    </for>
  </section>
</main>
