---
page article
---
<title>{article.title} - {shopName}</title>
<main class="article" id="main">
  <json-ld>{{"@context": "https://schema.org", "@type": "Article", headline: article.title, datePublished: article.publishedAt, url: article.url, author: {"@type": "Person", name: article.author.name}}}</json-ld>
  <header class="article__header">
    <h1 class="article__title">{article.title}</h1>
    <p class="article__byline">
      <if {article.author.avatar != none}>
        <img
          class="article__avatar"
          src={imgUrl(article.author.avatar, 96)}
          alt={article.author.name}
          width="96"
          height="96"
          loading="lazy"
        />
      </if>
      <if {article.author.url != none}>
        <a class="article__author" href={article.author.url} rel="author">{article.author.name}</a>
      </if>
      <else><span class="article__author">{article.author.name}</span></else>
      <time class="article__date" datetime={article.publishedAt}>
        {article.publishedAt |> formatDate("MMMM D, YYYY")}
      </time>
    </p>
    <if {size(article.tags) > 0}>
      <ul class="article__tags">
        <for tag of={article.tags} limit={8}>
          <li class="article__tag">
            <a href="/blog/tagged/{tag |> slugify}">{tag}</a>
          </li>
        </for>
      </ul>
    </if>
  </header>
  <div class="article__body">{article.bodyHtml |> richtext}</div>
  <footer class="article__footer">
    <p class="article__summary">{article.excerpt ?? "Thanks for reading."}</p>
  </footer>
</main>
