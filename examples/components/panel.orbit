---
component Panel
props {
  tone: String = "neutral"
}
slots {
  header
  footer?
}
---
<section class="panel panel--{tone}">
  <header class="panel__header">
    <slot name="header"/>
  </header>
  <div class="panel__body">
    <slot/>
  </div>
  <footer class="panel__footer">
    <slot name="footer"/>
  </footer>
</section>
