{
  "category": "named-args-accepted",
  "cases": [
    {
      "id": "named-args-accepted/positional-only",
      "category": "named-args-accepted",
      "template": "---\npage page\n---\n<p>{knobs(data.text, 1, \"z\", 3)}</p>\n",
      "bindings": {
        "data": {
          "text": "x",
          "url": "/url",
          "note": null,
          "count": 4,
          "ratio": 0,
          "flag": false,
          "tags": [],
          "style": "info",
          "items": []
        }
      },
      "expect": {
        "kind": "html",
        "html": "<p>x[a=1][b=z][c=3]</p>",
        "warnings": []
      }
