{
  "category": "custom-properties",
  "cases": [
    {
      "id": "custom-properties/one-property",
      "category": "custom-properties",
      "template": "---\npage page\nsettings {\n  tint: Color = #1a73e8 label \"Tint\"\n  label: Text = \"hi\" label \"Label\"\n  tone: Select(\"a\", \"b\") = \"a\" label \"Tone\"\n}\n---\n<div --accent={settings.tint}>x</div>\n",
      "bindings": {
        "data": {
          "text": "text",
          "url": "/url",
          "note": null,
          "count": 0,
          "ratio": 0,
          "flag": false,
          "tags": [],
          "style": "info",
          "items": []
        }
      },
      "expect": {
        "kind": "html",
        "html": "<div style=\"--accent:#1a73e8\">x</div>",
        "warnings": []
      }
    },
