    {
      "id": "component/call-basic",
      "category": "component",
      "template": "---\npage page\n---\n<Box label=\"hi\"/>\n",
      "extraTemplates": {
        "box.orbit": "---\ncomponent Box\nprops {\n  label: String\n  emphasis: Bool = false\n}\nslots {\n  extra?\n}\n---\n<div class=\"box\"><if {emphasis}><strong>{label}</strong></if><else><span>{label}</span></else><slot name=\"extra\"/></div>\n"
      },
      "bindings": {
        "data": {
          "text": "text",
          "url": "/url",
          "note": null,
          "count": 0,
          "ratio": 0,
          "flag": false,
          "tags": [],
          "items": []
        }
      },
      "expect": {
        "kind": "html",
        "html": "<div class=\"box\"><span>hi</span></div>",
        "warnings": []
      }
    },
