# Attach a signed provenance attestation to every publish. Paired with
# package.json#publishConfig.provenance and the OIDC trusted-publisher flow in
# .github/workflows/release.yml (there is no NODE_AUTH_TOKEN anywhere).
provenance=true

# --- dependency build scripts -------------------------------------------------
# pnpm >= 10 refuses to run dependency lifecycle scripts unless allowlisted, and
# FAILS the install (ERR_PNPM_IGNORED_BUILDS, exit 1) rather than merely warning
# — so this is a CI-blocking setting, not cosmetic. esbuild's postinstall
# fetches its platform-specific binary and cannot work without it.
#
# The allowlist lives in pnpm-workspace.yaml:
#
#   allowBuilds:
#     esbuild: true
#
# NOT in package.json. pnpm 11 no longer reads the `pnpm` field at all ("The
# 'pnpm' field in package.json is no longer read by pnpm") and prints a warning
# on every command if one is present, so the field was removed.
#
# It is not duplicated here either: `only-built-dependencies[]` is a pnpm-only
# key and npm emits "Unknown project config" for it on every single command.
